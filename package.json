{
  "name": "zoology-department-library",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm test && pnpm test:db && pnpm build && pnpm test:e2e",
    "format": "prettier --write src tests scripts *.ts *.json *.md .github/workflows",
    "test:pages": "node scripts/test-pages.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.0",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "embedded-postgres": "^18.1.0-beta.15",
    "jsdom": "^26.0.0",
    "pg": "^8.13.0",
    "prettier": "3.6.2",
    "typescript": "~5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
